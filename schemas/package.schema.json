{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MythWeave-ttrpg/mythweave-registry/schemas/package.schema.json",
  "title": "MythWeave registry package manifest",
  "type": "object",
  "required": [
    "id",
    "kind",
    "title",
    "description",
    "author",
    "license",
    "versions"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "kind": {
      "enum": ["pack", "rules-plugin", "integration-plugin", "sheet"]
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "homepage": { "type": "string", "pattern": "^https://\\S+$" },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/version" }
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "required": [
        "version",
        "sha256",
        "sizeBytes",
        "appVersion",
        "dependencies",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "appVersion": { "type": "string", "minLength": 1 },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "yanked": {
          "type": "object",
          "required": ["reason"],
          "additionalProperties": false,
          "properties": {
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "url"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "https" },
            "url": {
              "type": "string",
              "pattern": "^https://[^\\s/@]+([/?#]\\S*)?$"
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "uri"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "magnet" },
            "uri": { "type": "string", "pattern": "^magnet:\\?" }
          }
        }
      ]
    }
  }
}
